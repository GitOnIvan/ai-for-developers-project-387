# ==============================================================================
# 🛠 Среды разработки и системный мусор (IDE & OS)
# ==============================================================================
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ==============================================================================
# 💻 БЭКЕНД: Java (Общие правила для Maven и Gradle)
# ==============================================================================
**/🎨/                 # Исключаем build/target во всех вложенных папках
**/target/
**/build/
**/out/

# Локальные файлы конфигурации среды и секреты
**/🎨/.gradle/
**/🎨/.mvn/
**/*.log
**/*.hprof
**/🎨/local.properties

# Скрипты обертки сборщиков (Wrapper) обычно коммитят,
# но логи и локальные бандлы встроенного софта игнорируем
.gradle/
.maven/

# ==============================================================================
# 🌐 ФРОНТЕНД: Node.js / Vue.js / Vite
# ==============================================================================
**/node_modules/
**/dist/
**/local/

# Логи серверов и сборщиков
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Редакторские настройки стилей (если они не командные)
.eslintcache
.stylelintcache

# ==============================================================================
# 🔐 Безопасность (Локальные переменные окружения и токены)
# ==============================================================================
*.env
*.env.local
*.env.*.local
.envrc
